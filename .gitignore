# dependencies
node_modules/

# build output
dist/
bin/
*.tsbuildinfo

# the UI build writes into the external bevy-explorer/deploy/web — not in this repo

# scene runtime
packages/scene/.dclcache/

# e2e harness artifacts (screenshots, console logs)
packages/desktop/validate/artifacts/

# desktop image packaging (electron-builder)
packages/desktop/release/
packages/desktop/staging/
packages/desktop/.node-cache/

# `npm run size:check` scratch (app-size.json is the tracked one)
size-reports/
size-report.md
base-app-size.json

# editor / OS
.DS_Store
*.log

# raw session transcripts (verbatim archive, large)
docs/transcripts/
.dev-shim/

# SDK skills, installed per-machine by the skills CLI (skills-lock.json records
# the upstream commit each came from). Not source: 20k+ lines of generated docs,
# and the .claude/skills entries are symlinks into .agents that only resolve on
# the machine that ran the installer. The repo's own skills stay tracked.
.agents/
agent/
skills-lock.json
.claude/skills/*
!.claude/skills/add-builtin-prefab
