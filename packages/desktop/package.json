{
  "name": "@dcl-editor/desktop",
  "version": "0.2.0",
  "description": "Desktop shell for the Decentraland scene editor — React UI in the window, engine in a same-origin iframe, one console-RPC seam",
  "author": "Decentraland Regenesis Labs",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node esbuild.mjs && npm run build:ui",
    "build:main": "node esbuild.mjs",
    "build:ui": "npm run build -w @dcl-editor/ui",
    "typecheck": "tsc --noEmit",
    "app": "electron .",
    "start": "npm run build && electron .",
    "stage": "node scripts/stage-resources.mjs",
    "dist": "npm run stage && electron-builder --publish never",
    "validate": "npm run build && node validate/validate.mjs",
    "test": "npm run typecheck && npm run validate"
  },
  "devDependencies": {
    "@dcl-editor/contract": "*",
    "electron": "42.4.1",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  }
}
